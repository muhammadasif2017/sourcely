# Copy to .env and fill in a key:  cp .env.example .env
# Only /ask and /ask/stream need an LLM key. /documents and /search work without one.

# ---------------------------------------------------------------------------
# LLM provider: "openai" (any OpenAI-compatible API) or "anthropic" (Claude)
# ---------------------------------------------------------------------------

# Active setup: Google Gemini free tier via its OpenAI-compatible endpoint.
# Get a key at https://aistudio.google.com/apikey
# Warning: Google may use free-tier prompts and responses to improve its products.
# Do not ingest confidential text while using a free-tier key.
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your-gemini-api-key
OPENAI_MODEL=gemini-3.5-flash-lite

# OpenAI: remove OPENAI_BASE_URL (or leave it empty) and set your OpenAI key.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini

# Claude (Anthropic).
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Ollama, fully local and free. Run `ollama serve` and `ollama pull qwen2.5:3b` first.
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:3b

# LLM_MAX_TOKENS=16000
# LLM_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Embeddings and storage (local, no key needed)
# ---------------------------------------------------------------------------
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=./data/models
# CHROMA_PATH=./data/chroma
# COLLECTION_NAME=documents

# ---------------------------------------------------------------------------
# Chunking and retrieval
# ---------------------------------------------------------------------------
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# MAX_DOCUMENT_CHARS=200000
# DEFAULT_TOP_K=4
# MIN_RELEVANCE=0.5

# LOG_LEVEL=INFO
